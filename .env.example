# Copie este arquivo para .env e preencha os valores

# String de conexão do MongoDB Atlas (inclua o nome do banco no final da URI)
STRING_CONEXAO=mongodb+srv://usuario:senha@cluster.mongodb.net/shelflog

# Porta do servidor (opcional, padrão 3000)
PORTA=3000

# Segredo usado para assinar o cookie de sessão (use um valor longo e aleatório)
SESSION_SECRET=troque-este-segredo

<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>ShelfLog — Perfil</title>
        <link rel="stylesheet" href="../public/styles/estilos_comuns.css">
        <link rel="stylesheet" href="../public/styles/perfil.css">
    </head>
    <body>
        <header>
            <img src="../imgs/logo.png" alt="Logo do ShelfLog" class="logo">
            <nav>
                <ul>
                    <li><a href="home.html">Home</a></li>
                    <li><a href="prateleira.html">Prateleiras</a></li>
                    <li><a href="busca.html">Buscar</a></li>
                    <li><a href="perfil.html">Perfil público</a></li>
                    <li><a href="../index.html" class="botao_sair">Sair</a></li>
                </ul>
            </nav>
        </header>

        <main>
            <div id="dados_iniciais_perfil">
                <div>
                    <h1>{{nome}}</h1>
                    <p>Membro desde {{anoDeIngresso}}</p>
                    <p>{{textoExplicativo}}</p>
                    </div>
                    <img src="{{avatar}}" alt="Avatar do usuário {{arroba}}">
            </div>

            <h2>Estatísticas literárias</h2>
            <div id="estatisticas_usuario">
                <img src="{{grafico}}" alt="Gráfico de pizza dos gêneros mais lidos pelo usuário {{arroba}}">
                <div>
                    <p>Livros lidos: {{quantidadeLivrosLidos}}</p>
                    <p>Nota média: {{notaMedia}}</p>

                    <p>Livro mais recente lido: {{livroMaisRecenteLido}}</p>
                    <p>Livro mais recente avaliado: {{estatisticasUsuario.livroMaisRecenteAvaliado}}</p>

                    <p>Prateleiras públicas:</p>
                    <ul>
                        {{#each prateleirasPublicas}}
                            <li>{{nomePrateleira}}</li>
                        {{/each}}
                    </ul>
                </div>
            </div>
        </main>

        <footer>
            <img src="../imgs/logo.png" alt="Logo do ShelfLog" class="logo">
            <div class="opcoes-footer">
                <p class="cabecalho1">ShelfLog</p>
                <p class="opcao11">Sobre nós</p>
                <p class="opcao12">Como funciona</p>
                <p class="opcao13">Contato</p>

                <p class="cabecalho2">Explorar</p>
                <p class="opcao21">Prateleiras populares</p>
                <p class="opcao22">Reviews recentes</p>
                <p class="opcao23">Buscar livros</p>

                <p class="cabecalho3">Conta</p>
                <p class="opcao31">Criar conta</p>
                <p class="opcao32">Entrar</p>
                <p class="opcao33">Meu perfil</p>
            </div>
        </footer>
    </body>
</html>

<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>ShelfLog — Prateleiras</title>
        <link rel="stylesheet" href="../public/styles/estilos_comuns.css">
        <link rel="stylesheet" href="../public/styles/prateleira.css">
    </head>
    <body>
        <header>
            <img src="../imgs/logo.png" alt="Logo do ShelfLog" class="logo">
            <nav>
                <ul>
                    <li><a href="home.html">Home</a></li>
                    <li><a href="prateleira.html">Prateleiras</a></li>
                    <li><a href="busca.html">Buscar</a></li>
                    <li><a href="perfil.html">Perfil público</a></li>
                    <li><a href="../index.html" class="botao_sair">Sair</a></li>
                </ul>
            </nav>
        </header>

        <main>
            <div id="menu-principal-prateleira">
                <h1>Suas prateleiras</h1>
                <button>Criar prateleira</button>
            </div>

            <div id="lista-prateleiras">
                {{#each prateleira}}
                    <div>
                        <div class="menu-prateleira-especifica">
                            <div>
                                <p>{{titulo}}</p>
                                <p>{{descricao}}</p>
                            </div>
                            <button>Adicionar livro</button>
                        </div>
                        <div>
                            <div class="lista-cards">
                                {{#each livros}}
                                    <article class="card card-com-fundo">
                                        <img src="{{capa}}" alt="Capa do livro {{titulo}}">
                                        <p>{{status}}</p>
                                        <p>{{titulo}}</p>
                                        <p>{{nota}}</p>
                                    </article>
                                {{/each}}
                            </div>
                        </div>
                    </div>
                {{/each}}
            </div>
        </main>

        <footer>
            <img src="../imgs/logo.png" alt="Logo do ShelfLog" class="logo">
            <div class="opcoes-footer">
                <p class="cabecalho1">ShelfLog</p>
                <p class="opcao11">Sobre nós</p>
                <p class="opcao12">Como funciona</p>
                <p class="opcao13">Contato</p>

                <p class="cabecalho2">Explorar</p>
                <p class="opcao21">Prateleiras populares</p>
                <p class="opcao22">Reviews recentes</p>
                <p class="opcao23">Buscar livros</p>

                <p class="cabecalho3">Conta</p>
                <p class="opcao31">Criar conta</p>
                <p class="opcao32">Entrar</p>
                <p class="opcao33">Meu perfil</p>
            </div>
        </footer>
    </body>
</html>

<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>ShelfLog — Buscar</title>
        <link rel="stylesheet" href="/styles/estilos_comuns.css">
        <link rel="stylesheet" href="/styles/busca.css">
        <script src="/script/autocomplete.js" defer></script>
    </head>
    <body>
        <header>
            <img src="/imgs/logo.png" alt="Logo do ShelfLog" class="logo">
            <nav>
                <ul>
                    <li><a href="/home">Home</a></li>
                    <li><a href="/prateleira">Prateleiras</a></li>
                    <li><a href="/busca">Buscar</a></li>
                    <li><a href="/perfil">Perfil público</a></li>
                    {{#if usuario}}<li class="nav-usuario">Olá, {{usuario.nome}}!</li>{{/if}}
                    <li><a href="/logout" class="botao_sair">Sair</a></li>
                </ul>
            </nav>
        </header>

        <main>
            {{#if mensagensSucesso.length}}<div class="flash flash-sucesso">{{#each mensagensSucesso}}<p>{{this}}</p>{{/each}}</div>{{/if}}
            {{#if mensagensErro.length}}<div class="flash flash-erro">{{#each mensagensErro}}<p>{{this}}</p>{{/each}}</div>{{/if}}
            <h1>Encontre seu próximo livro</h1>

            <form method="get" action="/busca">
                <div class="busca-wrap">
                    <input type="search" name="nome" value="{{termo}}" placeholder="Digite o nome de um livro" data-autocomplete="navegar" required>
                    <button type="submit">Buscar</button>
                </div>

                <p class="filtros-label">Filtrar busca de livros por:</p>
                <div class="filtros">
                    <label for="genero">Gênero
                        <input type="text" id="genero" name="genero" value="{{genero}}" placeholder="Ex.: fantasy">
                    </label>
                    <label for="nota-minima">Nota mínima
                        <input type="text" id="nota-minima" name="notaMinima" value="{{notaMinima}}" placeholder="Ex.: 4.0">
                    </label>
                </div>
            </form>

            {{#if buscou}}
            <div id="resultados-busca">
                <p>Resultados para "{{termo}}"</p>
                <div id="lista-resultados" class="lista-cards">
                    {{#each resultados}}
                        <a class="card" href="/livro/{{livroId}}">
                            <img src="{{capa}}" alt="Capa do livro {{titulo}}">
                            <p>{{titulo}}</p>
                            <p>{{autor}}</p>
                            <p>{{notaExterna}}</p>
                        </a>
                    {{else}}
                        <p>Nenhum livro encontrado.</p>
                    {{/each}}
                </div>
            </div>
            {{/if}}
        </main>

        <footer>
            <img src="/imgs/logo.png" alt="Logo do ShelfLog" class="logo">
            <div class="opcoes-footer">
                <p class="cabecalho1">ShelfLog</p>
                <p class="opcao11">Sobre nós</p>
                <p class="opcao12">Como funciona</p>
                <p class="opcao13">Contato</p>

                <p class="cabecalho2">Explorar</p>
                <p class="opcao21">Prateleiras populares</p>
                <p class="opcao22">Reviews recentes</p>
                <p class="opcao23">Buscar livros</p>

                <p class="cabecalho3">Conta</p>
                <p class="opcao31">Criar conta</p>
                <p class="opcao32">Entrar</p>
                <p class="opcao33">Meu perfil</p>
            </div>
        </footer>
    </body>
</html>

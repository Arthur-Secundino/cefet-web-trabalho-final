<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>ShelfLog — Home</title>
        <link rel="stylesheet" href="/styles/estilos_comuns.css">
        <link rel="stylesheet" href="/styles/home.css">
    </head>
    <body>
        <header>
            <img src="/imgs/logo.png" alt="Logo do ShelfLog" class="logo">
            <nav>
                <ul>
                    <li><a href="/home">Home</a></li>
                    <li><a href="/prateleira">Prateleiras</a></li>
                    <li><a href="/busca">Buscar</a></li>
                    <li><a href="/perfil">Perfil público</a></li>
                    {{#if usuario}}<li class="nav-usuario">Olá, {{usuario.nome}}!</li>{{/if}}
                    <li><a href="/logout" class="botao_sair">Sair</a></li>
                </ul>
            </nav>
        </header>

        <main>
            {{#if mensagensSucesso.length}}<div class="flash flash-sucesso">{{#each mensagensSucesso}}<p>{{this}}</p>{{/each}}</div>{{/if}}
            {{#if mensagensErro.length}}<div class="flash flash-erro">{{#each mensagensErro}}<p>{{this}}</p>{{/each}}</div>{{/if}}
            <h1>Em alta na comunidade</h1>
            <p>Os livros que estão movimentando os leitores neste momento.</p>
            <div id="livros_em_alta" class="lista-cards">
                {{#each livrosEmAlta}}
                    <a class="card limita-largura" href="/livro/{{livroId}}">
                        <img src="{{capa}}" alt="Capa do livro {{titulo}}" class="centraliza-imagem">
                        <p>{{titulo}}</p>
                    </a>
                {{else}}
                    <p>Ainda não há livros em alta. Adicione livros às suas prateleiras e torne-as públicas!</p>
                {{/each}}
            </div>

            <h2>Prateleiras pra se inspirar</h2>
            <div id="prateleiras_em_alta">
                {{#each prateleirasEmAlta}}
                    <div class="prateleira-inspira">
                        <div class="prateleira-inspira-cabecalho">
                            <h3>{{nome}}</h3>
                            <p>{{descricao}}</p>
                        </div>
                        <div class="faixa-livros">
                            {{#each livros}}
                                <a class="livro-mini" href="/livro/{{livroId}}" title="{{titulo}}">
                                    <img src="{{capa}}" alt="Capa de {{titulo}}">
                                </a>
                            {{else}}
                                <p>Prateleira ainda sem livros.</p>
                            {{/each}}
                        </div>
                    </div>
                {{else}}
                    <p>Ainda não há prateleiras públicas. Torne uma das suas pública para aparecer aqui!</p>
                {{/each}}
            </div>
            

            <h2>Reviews recentes</h2>
            <div id="reviews_recentes" class="lista-cards">
                {{#each reviewsRecentes}}
                    <article class="review card">
                        <article class="card card-interno">
                            <img src="{{livro.capa}}" alt="Capa do livro {{livro.titulo}}" class="centraliza-imagem">
                            <p>{{livro.titulo}}</p>
                            <p>{{avaliacao.nota}}</p>
                        </article>
                        <div class="dados-usuario">
                            <img src="{{usuario.avatar}}" alt="Avatar do usuário {{usuario.arroba}}" class="avatar-usuario">
                            <div>
                                <p>{{usuario.nome}}</p>
                                <p>{{usuario.arroba}}</p>
                            </div>
                        </div>
                        <p>{{avaliacao.comentario}}</p>
                    </article>
                {{/each}}
            </div>
        </main>

        <footer>
            <img src="/imgs/logo.png" alt="Logo do ShelfLog" class="logo">
            <div class="opcoes-footer">
                <p class="cabecalho1">ShelfLog</p>
                <p class="opcao11"><a href="/sobre#sobre-nos">Sobre nós</a></p>
                <p class="opcao12"><a href="/sobre#como-funciona">Como funciona</a></p>
                <p class="opcao13"><a href="/sobre#contato">Contato</a></p>

                <p class="cabecalho2">Explorar</p>
                <p class="opcao21"><a href="/home">Prateleiras populares</a></p>
                <p class="opcao22"><a href="/home">Reviews recentes</a></p>
                <p class="opcao23"><a href="/busca">Buscar livros</a></p>

                <p class="cabecalho3">Conta</p>
                <p class="opcao31"><a href="/">Criar conta</a></p>
                <p class="opcao32"><a href="/">Entrar</a></p>
                <p class="opcao33"><a href="/perfil">Meu perfil</a></p>
            </div>
        </footer>
    </body>
</html>

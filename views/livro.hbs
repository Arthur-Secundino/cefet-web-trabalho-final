<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>ShelfLog — Livro</title>
        <link rel="stylesheet" href="/styles/estilos_comuns.css">
        <link rel="stylesheet" href="/styles/livro.css">
    </head>
    <body>
        <header>
            <img src="/imgs/logo.png" alt="Logo do ShelfLog" class="logo">
            <nav>
                <ul>
                    <li><a href="/home">Home</a></li>
                    <li><a href="/prateleira">Prateleiras</a></li>
                    <li><a href="/busca">Buscar</a></li>
                    <li><a href="/perfil">Perfil público</a></li>
                    {{#if usuario}}<li class="nav-usuario">Olá, {{usuario.nome}}!</li>{{/if}}
                    <li><a href="/logout" class="botao_sair">Sair</a></li>
                </ul>
            </nav>
        </header>

        <main>
            {{#if mensagensSucesso.length}}<div class="flash flash-sucesso">{{#each mensagensSucesso}}<p>{{this}}</p>{{/each}}</div>{{/if}}
            {{#if mensagensErro.length}}<div class="flash flash-erro">{{#each mensagensErro}}<p>{{this}}</p>{{/each}}</div>{{/if}}
            <div id="dados-livro">
                <img src="{{livro.capa}}" alt="Capa do livro {{livro.titulo}}">
                     <div>
                        <h3>{{livro.titulo}}</h3>
                        <p>{{livro.autor}}</p>
                        <p>{{livro.sinopse}}</p>
                        <p>{{livro.status}}</p>

                        {{#if usuario}}
                        <form method="post" action="/livro/{{livro.livroId}}">
                            <h3 id="sua-avaliacao">Sua avaliação</h3>
                            <input type="hidden" name="titulo" value="{{livro.titulo}}">
                            <label>Nota (0 a 5)
                                <input type="number" name="nota" min="0" max="5" step="0.5" required>
                            </label>
                            <textarea name="comentario" id="comentario-usuario" placeholder="O que você achou?"></textarea>
                            <button type="submit">Salvar avaliação</button>
                        </form>
                        {{else}}
                        <p><a href="/">Entre na sua conta</a> para avaliar este livro.</p>
                        {{/if}}
                </div>
            </div>

            <h3>Avaliações de outros usuários</h3>
            <div id="lista-avaliacoes">
                {{#each avaliacoes}}
                    <div>
                        <div class="dados-usuario">
                            <img src="{{usuario.avatar}}" alt="Avatar do usuário {{usuario.arroba}}" class="avatar-usuario">
                            <div>
                                <p>{{usuario.nome}}</p>
                                <p>{{usuario.arroba}}</p>
                            </div>
                        </div>
                        <p>{{nota}}</p>
                        <p>{{comentario}}</p>
                    </div>
                {{/each}}
            </div>
        </main>

        <footer>
            <img src="/imgs/logo.png" alt="Logo do ShelfLog" class="logo">
            <div class="opcoes-footer">
                <p class="cabecalho1">ShelfLog</p>
                <p class="opcao11">Sobre nós</p>
                <p class="opcao12">Como funciona</p>
                <p class="opcao13">Contato</p>

                <p class="cabecalho2">Explorar</p>
                <p class="opcao21">Prateleiras populares</p>
                <p class="opcao22">Reviews recentes</p>
                <p class="opcao23">Buscar livros</p>

                <p class="cabecalho3">Conta</p>
                <p class="opcao31">Criar conta</p>
                <p class="opcao32">Entrar</p>
                <p class="opcao33">Meu perfil</p>
            </div>
        </footer>
    </body>
</html>
